# Copie para .env.local e preencha (Project Settings → API no painel do Supabase)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional: código de afiliado do Amazon Associados ("tag", ex.: seunome-20) para os links de "Onde comprar".
# Sem ele, os links funcionam normalmente, sem comissão. Na Cloudflare, cadastre como variável de build.
# VITE_AFILIADO_AMAZON=
